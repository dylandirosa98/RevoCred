APP_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/revocred?sslmode=disable
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s
DB_MAX_CONNS=10
METRICS_TOKEN=
# Developer testing only: AI_* wins over the older OPENCODE_GO_* names.
# Production never falls back to OPENCODE_GO_* and requires explicit OpenAI settings.
# OpenAI: AI_BASE_URL=https://api.openai.com/v1, AI_MODEL=gpt-6-luna, AI_REASONING_EFFORT=none
AI_API_KEY=
AI_MODEL=deepseek-v4.1-flash
AI_BASE_URL=https://opencode.ai/zen/go/v1
AI_REASONING_EFFORT=
# Keyless search: run compose.search.yaml and set provider/base URL below.
# SEARCH_PROVIDER=searxng
# SEARCH_BASE_URL=http://127.0.0.1:8096/search
# Alternatively use brave with its API key; default brave without a key is off.
SEARCH_PROVIDER=brave
SEARCH_BASE_URL=
SEARCH_API_KEY=
# External-AI chat replies allowed per user per rolling 24 hours.
CHAT_DAILY_AI_LIMIT=60
CHAT_FREE_DAILY_AI_LIMIT=3
# REVO AI subscription through RevenueCat. Empty webhook auth keeps the webhook
# disabled (404) and the app never offers a purchase. See
# docs/app-store/subscription.md.
REVENUECAT_WEBHOOK_AUTH=
REVENUECAT_SECRET_API_KEY=
REVENUECAT_ENTITLEMENT_ID=revo_ai
# Sandbox/TestFlight purchases count by default outside production.
REVENUECAT_ALLOW_SANDBOX=
